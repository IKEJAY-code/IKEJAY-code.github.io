---
import View from '../../views/ResearchDetail.astro';
import { getPapers } from '../../data/research';
export function getStaticPaths() { return getPapers('en').map(paper=>({ params: { slug:paper.slug }, props: { slug:paper.slug } })); }
const { slug } = Astro.props;
---
<View lang="en" slug={slug} />
