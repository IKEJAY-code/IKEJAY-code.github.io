---
import Base from '../layouts/Base.astro';
import Field from '../components/Field.astro';
import Icon from '../components/Icon.astro';
import PaperCard from '../components/PaperCard.astro';
import { getPapers } from '../data/research';
import { profile } from '../data/profile';
import { getPosts, formatDate, readingTime } from '../lib/writing';
import { ui, text, localPath, type Lang } from '../lib/i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = ui[lang], href = (path: string) => localPath(lang,path);
const papers = getPapers(lang);
const posts = (await getPosts(lang)).slice(0,3);
---
<Base lang={lang}>
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot"></span>{text(lang,'A LITTLE CURIOSITY. A LOT OF QUESTIONS.','保持一点好奇，追问更多可能。')}</p>
      <div class="hero-identity"><h1>Yujie<br /><span class="serif">Huang<span class="accent">.</span></span></h1><a class="hero-portrait" href={href('/about/')} aria-label={t.moreAbout}><img src="/images/yujie.jpg" alt={t.portrait} width="1080" height="1440" fetchpriority="high" /></a></div>
      <p class="hero-lede">{text(lang,'Exploring intelligence,','你好，我是黄裕杰。')}<br />{text(lang,'one question at a time.','让好奇，成为探索的起点。')}</p>
      <p class="hero-description">{text(lang,'A second-year master’s student at Fujian University of Technology, exploring large language models and AI agents.','福建理工大学研二学生，关注大语言模型与智能体。')}<br class="desktop-break" />{text(lang,'Finding stability in reasoning, and patterns in the unknown.','在推理的流动中寻找稳定，在未知中发现规律。')}</p>
      <div class="hero-actions"><a class="button primary" href={href('/research/')}>{text(lang,'Explore my research','探索我的研究')}<Icon name="external" size={17} /></a><a class="text-link" href={href('/about/')}>{text(lang,'A little about me','关于我的一些事')}<Icon name="arrow" size={17} /></a></div>
    </div>
    <Field lang={lang} />
    <div class="hero-bottom"><span class="mono">{text(lang,'LLMs / AGENTS / AI FOR SCIENCE','大语言模型 / 智能体 / 科学智能')}</span><a class="scroll-cue" href="#research">{text(lang,'Scroll to explore','向下探索')}<span>↓</span></a></div>
  </section>
  <div class="recognition-strip wrap"><span class="eyebrow">{text(lang,'RECENT HIGHLIGHTS','近期动态')}</span><a href={href('/research/thinking-in-flow/')}><span class="small-star">✳</span> ICML 2026 <strong>Spotlight</strong></a><span class="recognition-divider"></span><a href={href('/about/#recognition')}>{text(lang,'UMI 2026 Youth Forum','UMI 2026 青年论坛')}<strong>{text(lang,'Best Paper Nomination','最佳论文提名')}</strong></a></div>
  <section class="section wrap" id="research">
    <div class="section-head" data-reveal><div><p class="eyebrow section-index">01 / {text(lang,'SELECTED RESEARCH','精选研究')}</p><h2>{text(lang,'Questions into','从问题出发，')} <em>{text(lang,'research.','抵达研究。')}</em></h2><p class="section-intro">{text(lang,'From stable language-model reasoning to agent-driven scientific discovery.','从语言模型的稳定推理，到科学智能体的方程发现。')}</p></div><a class="text-link section-more" href={href('/research/')}>{t.allResearch}<Icon name="external" size={18} /></a></div>
    <div class="paper-grid">{papers.map((paper,index) => <PaperCard lang={lang} paper={paper} index={index} />)}</div>
  </section>
  <section class="writing-section section wrap">
    <div class="section-head" data-reveal><div><p class="eyebrow section-index">02 / {text(lang,'NOTES ALONG THE WAY','沿途的笔记')}</p><h2>{text(lang,'Thinking,','让思考，')} <em>{text(lang,'out loud.','被听见。')}</em></h2><p class="section-intro">{text(lang,'A growing space for the thoughts that live beyond a paper.','给论文之外的思考，留一个持续生长的地方。')}</p></div><a class="text-link section-more" href={href('/writing/')}>{t.allWriting}<Icon name="external" size={18} /></a></div>
    {posts.length ? <div class="post-list">{posts.map((post,index) => <article class="post-row" data-reveal><span class="post-no mono">0{index+1}</span><a class="post-main" href={href(`/writing/${post.slug}/`)}><div class="post-tags"><span>{post.data.tags[0]}</span>{post.data.example && <span class="example-label">{t.example}</span>}</div><h3>{post.data.title}</h3><p>{post.data.description}</p></a><span class="post-date mono">{formatDate(post.data.pubDate,lang)}<small>{readingTime(post.body)} {t.minute}</small></span><a class="round-arrow" href={href(`/writing/${post.slug}/`)} aria-label={`${t.read}: ${post.data.title}`}><Icon name="external" /></a></article>)}</div> : <p class="empty-state">{text(lang,'Notes are on their way.','笔记正在路上。')}<a href={href('/rss.xml')}>{t.subscribe}</a></p>}
  </section>
  <section class="about-teaser wrap" data-reveal>
    <a href={href('/about/')} class="portrait-link" aria-label={t.moreAbout}><img src="/images/yujie.jpg" alt={t.photo} width="1080" height="1440" loading="lazy" /></a>
    <div><p class="eyebrow section-index">03 / {text(lang,'THE PERSON BEHIND THE PAPERS','论文之外的我')}</p><h2>{text(lang,'A researcher.','是研究者，')}<br /><em>{text(lang,'And a curious human.','也是一个好奇的人。')}</em></h2><p>{text(lang,'Hi, I’m Yujie. This is where I collect my research, thoughts, and explorations.','你好，我是黄裕杰。这里收集我的研究、思考和探索。')}<br />{text(lang,'I care about how models reason, and how they can help us understand the world.','我关心模型如何推理，也关心它们能如何帮助我们理解世界。')}</p><a class="text-link" href={href('/about/')}>{t.moreAbout}<Icon name="arrow" size={18} /></a></div><span class="about-side-note mono">{text(lang,'ALWAYS A WORK IN PROGRESS.','始终，未完待续。')}</span>
  </section>
  <section class="contact-section wrap" data-reveal><p class="eyebrow">{text(lang,'GOOD RESEARCH STARTS WITH A CONVERSATION.','好的研究，始于一次对话。')}</p><h2>{text(lang,'Have a question?','有一个问题？')}<br /><a href={`mailto:${profile.email}`}>{text(lang,'Let’s','那就')} <em>{text(lang,'talk.','聊聊。')}</em><Icon name="external" size={48} /></a></h2><a class="email-link" href={`mailto:${profile.email}`}>{profile.email}</a></section>
</Base>
