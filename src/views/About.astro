---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
import { ui, text, localPath, cvFile, type Lang } from '../lib/i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = ui[lang], href = (path: string) => localPath(lang,path);
const interests = [
  [text(lang,'Large Language Models','大语言模型'),text(lang,'Reasoning processes, stability, and robustness.','推理过程、稳定性与鲁棒性。')],
  [text(lang,'AI Agents','智能体'),text(lang,'Hypothesis generation, evaluation, and iterative refinement.','假设、评估与迭代修正。')],
  [text(lang,'AI for Science','科学智能'),text(lang,'From observed data to interpretable governing laws.','从观测数据到可解释的动力学规律。')],
];
---
<Base lang={lang} title={t.about}>
  <section class="about-hero wrap"><div><p class="eyebrow">{text(lang,'ABOUT / BEYOND THE ABSTRACT','关于我 / 摘要之外')}</p><h1>{text(lang,'Hi, I’m Yujie','你好，我是裕杰')}<span class="accent">.</span><br /><em>{text(lang,'Always curious.','黄裕杰。')}</em></h1><p class="about-lede">{text(lang,'Curious about how','对智能如何发生，')}<br />{text(lang,'intelligence takes shape.','始终抱有好奇。')}</p><p>{text(lang,'I am a second-year master’s student at Fujian University of Technology, working on large language models and AI agents.','我目前是福建理工大学的硕士研究生（二年级），研究方向是大语言模型与智能体。')}</p><p>{text(lang,'From more stable model reasoning to agent-driven scientific discovery, my research explores how models form hypotheses, use evidence, and revise their judgments.','从让模型更稳定地推理，到让智能体参与科学发现，我的研究围绕模型如何提出问题、使用证据并修正判断展开。')}</p><div class="hero-actions"><a class="button primary" href={href('/cv/')}>{t.viewCV}<Icon name="external" size={17} /></a><a class="text-link" href={cvFile('en')} download>English PDF <Icon name="download" size={17} /></a><a class="text-link" href={cvFile('zh')} download>{text(lang,'Chinese PDF','中文 PDF')}<Icon name="download" size={17} /></a></div></div><figure class="about-portrait"><img src="/images/yujie.jpg" alt={t.photo} width="1080" height="1440" /><figcaption class="mono">{text(lang,'THE PERSON BEHIND THE PAPERS.','论文之外的我。')} &nbsp; ↗</figcaption></figure></section>
  <div class="about-details wrap"><aside><p class="eyebrow">{text(lang,'A FEW THINGS ABOUT ME','关于我的一些事')}</p><a href={`mailto:${profile.email}`}>{profile.email}</a><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub / IKEJAY-code ↗</a></aside><div>
    <section class="about-block"><p class="eyebrow">01 / {text(lang,'EDUCATION','教育背景')}</p><h2>{text(lang,profile.universityEn,profile.university)}</h2><p>{text(lang,profile.stageEn,profile.stage)}</p><p class="quiet-note">{text(lang,'Research: LLMs · Agents','研究方向：大语言模型 · 智能体')}</p></section>
    <section class="about-block"><p class="eyebrow">02 / {text(lang,'RESEARCH INTERESTS','研究兴趣')}</p>{interests.map(([title,description],index)=><div class="interest-row"><span>0{index+1}</span><div><h3>{title}</h3><p>{description}</p></div></div>)}</section>
    <section class="about-block" id="recognition"><p class="eyebrow">03 / {text(lang,'RECOGNITION','荣誉与认可')}</p><div class="award-row"><span class="mono">2026</span><div><h3>ICML Spotlight</h3><a href={href('/research/thinking-in-flow/')}>Thinking in Flow ↗</a></div></div><div class="award-row"><span class="mono">2026</span><div><h3>{text(lang,'Best Paper Nomination','最佳论文提名')}</h3><p>{text(lang,'UMI 2026 Youth Forum','UMI 2026 青年论坛')}</p></div></div><div class="award-row"><span class="mono">2026</span><div><h3>{text(lang,'First-Class Scholarship','一等奖学金')}</h3><p>Top 5%</p></div></div></section>
  </div></div>
</Base>
