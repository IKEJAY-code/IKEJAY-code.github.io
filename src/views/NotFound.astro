---
import Base from '../layouts/Base.astro';
import { text, localPath, type Lang } from '../lib/i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
---
<Base lang={lang} title={text(lang,'Page not found','页面未找到')} switchTo={localPath(lang === 'en' ? 'zh' : 'en')} noindex><section class="not-found wrap"><p class="eyebrow">404 / {text(lang,'A SMALL DETOUR','一点小小的偏航')}</p><h1>{text(lang,'Not all paths','并非每条路，')}<br /><em>{text(lang,'lead somewhere.','都有终点。')}</em></h1><p>{text(lang,'This page is not here. Let’s explore another idea.','这个页面暂时不存在，回去看看其他想法吧。')}</p><a class="button primary" href={localPath(lang)}>{text(lang,'Back home','回到首页')} ↗</a></section></Base>
